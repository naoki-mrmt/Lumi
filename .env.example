# Lumi: ローカル / CI 用環境変数のテンプレート
# 実値は .env にコピーして記入 (`.env` は .gitignore 済み)。

# Supabase (本番 / 開発)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key-only-server-side

# Edge Functions
LUMI_VIEWER_JWT_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Apple Sign in with Apple (Supabase Auth に登録)
SUPABASE_AUTH_APPLE_CLIENT_ID=com.muramoto-co.lumi
SUPABASE_AUTH_APPLE_SECRET=jwt-from-apple-developer-private-key

# Sentry
SENTRY_DSN=https://your-key@sentry.io/your-project

# 注: VideoStreamFeature は Apple 純正 MultipeerConnectivity を使用するため、
# 外部 SDK (Agora / Twilio 等) のキーは不要。サーバ・ランニングコストもゼロ。
